import java.util.*;

class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        ArrayList<Integer> nums = new ArrayList<>();

        while (sc.hasNextInt()) {
            nums.add(sc.nextInt());
        }

        int k = nums.remove(nums.size() - 1);

        int count = 0;

        for (int i = 0; i < nums.size(); i++) {
            int sum = 0;

            for (int j = i; j < nums.size(); j++) {
                sum += nums.get(j);

                if (sum == k) {
                    count++;
                }
            }
        }

        System.out.println("The count of the subarray whereas equals to the target is : " + count);
    }
}
